{
  "manifest_version": 3,
  "name": "Google Maps Scanner Pro",
  "version": "2.4.0",
  "description": "Scan và extract dữ liệu từ Google Maps - Safe Navigation (No New Tabs)",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://www.google.com.vn/maps/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.com.vn/maps/*"
      ],
      "js": [
        "selectors.js",
        "utils.js",
        "extractor.js",
        "scroller.js",
        "scanner.js",
        "main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}